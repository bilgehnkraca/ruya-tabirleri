# Expo Mobil Ortam Değişkenleri
# Bu dosyayı .env.local olarak kopyalayın ve gerçek değerleri girin
# .env.local dosyası .gitignore'da, Git'e yüklenmez

# RevenueCat (Ödeme Sistemi)
EXPO_PUBLIC_REVENUECAT_APPLE=buraya_apple_revenuecat_keyini_yaz
EXPO_PUBLIC_REVENUECAT_GOOGLE=buraya_google_revenuecat_keyini_yaz

# AdMob
EXPO_PUBLIC_ADMOB_REWARDED_ID=ca-app-pub-xxxxxxxxxxxxx/yyyyyyyyyyyy

# Backend AI Proxy URL (Gemini Key artık burada DEĞİL, backend'de!)
EXPO_PUBLIC_API_BASE_URL=https://www.ruyasozlugunuz.com
