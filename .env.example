# Next.js Backend Ortam Değişkenleri
# Bu dosyayı .env.local olarak kopyalayın ve gerçek değerleri girin
# .env.local dosyası .gitignore'da olduğu için Git'e yüklenmez

# Gemini AI (Sunucu tarafında - EXPO_PUBLIC_ olmadan!)
GEMINI_API_KEY=buraya_gercek_gemini_api_keyini_yaz

# Site URL (Canonical için)
NEXT_PUBLIC_SITE_URL=https://www.ruyasozlugunuz.com
